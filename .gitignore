##########################################################
#   Spring Boot 專案 .gitignore
#   適用 Maven / Gradle
##########################################################

##############################
# 編譯與打包產物
##############################
*.class
*.jar
*.war
*.ear
target/
build/

# 前端打包產物（由 frontend/ 執行 npm run build 生成，不進版控避免衝突）
src/main/resources/static/farmily-web/

# 部落格圖片匯入成品（由 sql/blog 的腳本自動產生，檔案太大不進版控；組員雙擊 .bat 重新產生）
src/main/resources/sql/blog/blog_photos_data.sql

##############################
# Maven
##############################
.mvn/
!/.mvn/wrapper/maven-wrapper.jar
mvnw
mvnw.cmd
dependency-reduced-pom.xml

##############################
# Gradle
##############################
.gradle/
!gradle/wrapper/gradle-wrapper.jar
gradlew
gradlew.bat

##############################
# IDE 設定
##############################
# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
out/
# Eclipse
.project
.classpath
.settings/
bin/
# VS Code
.vscode/

##############################
# 系統與暫存檔
##############################
.DS_Store
Thumbs.db
*.tmp
*.swp
*.swo

##############################
# 日誌與紀錄
##############################
*.log

##############################
# 環境變數與憑證檔案
##############################
.env
.env.*
*.key
*.pem

##############################
# 測試輸出
##############################
/test-output/
/surefire-reports/
/jacoco.exec

##############################
# Redis（本機開發：redis-server 在專案目錄啟動時會產生快照檔）
##############################
dump.rdb
